{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "useDefineForClassFields": true,
    "noEmit": true,
    "types": ["vite/client"]
  },
  // middleware.ts sits at the repo root because that is where Vercel looks for
  // it, but it imports application modules and must be typechecked with them.
  "include": ["src", "middleware.ts"],
  // Tests are compiled by tsconfig.test.json, not by the app build. They use
  // Node APIs (suite.test.ts reads the route files to check that the registries
  // and the routers agree), and giving the whole application Node's globals so
  // that a test can have them would let app code reach for `fs` by accident.
  "exclude": ["src/**/*.test.ts"]
}
